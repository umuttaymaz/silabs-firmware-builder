project_name: openthread_ftd
label: OpenThread - SoC CLI (FTD)
package: openthread
category: OpenThread Examples
quality: production
description: Standalone OpenThread Full Thread Device (router) with CLI on the
  serial port. Derived from the `ot-cli-ftd` example Simplicity SDK project.
  Auto-starts Thread on boot when an Active Dataset is stored.
author: Nerivec (fork)
sdk:
  vendor: silabs
  id: simplicity_sdk
  version: 2026.6.2
toolchain_settings: []

component:
  - id: sl_main
  - id: ot_stack_ftd
  - id: ot_cli_source
  - id: ot_crash_handler
  - id: iostream_usart
    instance:
      - vcom
    condition:
      - device_generic_family_efr32xg21
  - id: iostream_eusart
    instance:
      - vcom
    condition:
      - device_has_eusart
  - id: rail_util_pti
  - id: bootloader_interface
  - id: clock_manager
  - id: ot_reset_utils
  # Platform - Enable LTO for gcc and llvm by installing the following component
  - id: toolchain_gcc_lto
    condition:
      - toolchain_gcc
  - id: toolchain_llvm_lto
    condition:
      - toolchain_llvm

configuration:
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: SL_MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED
    value: 1
  - name: SL_MBEDTLS_KEY_EXCHANGE_PSK_ENABLED
    value: 1
  - name: SL_IOSTREAM_USART_VCOM_BAUDRATE
    value: 115200
    condition:
      - iostream_usart
  - name: SL_IOSTREAM_EUSART_VCOM_BAUDRATE
    value: 115200
    condition:
      - iostream_eusart
  - name: SL_IOSTREAM_USART_VCOM_RX_BUFFER_SIZE
    value: 128
    condition:
      - iostream_usart
  - name: SL_IOSTREAM_EUSART_VCOM_RX_BUFFER_SIZE
    value: 128
    condition:
      - iostream_eusart
  # Stack sizes taken from the ot-cli-ftd sample (LTO, no RTOS)
  - name: SL_STACK_SIZE
    value: 6144
  - name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
    value: 5120
    condition:
      - sl_main
  - name: SL_OPENTHREAD_STACK_TASK_MEM_SIZE
    value: 7168
  - name: OPENTHREAD_CONFIG_LOG_OUTPUT
    value: OPENTHREAD_CONFIG_LOG_OUTPUT_PLATFORM_DEFINED
    condition:
      - ot_rtt_log
  - name: BUFFER_SIZE_UP
    value: 768
    condition:
      - ot_rtt_log
  - name: BUFFER_SIZE_DOWN
    value: 0
    condition:
      - ot_rtt_log
  - name: CIRCULAR_QUEUE_LEN_MAX
    value: 16
  - name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
    value: usartHwFlowControlCtsAndRts
    condition:
      - iostream_usart
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS
    condition:
      - iostream_eusart

include:
  - path: .
    file_list:
      - path: app.h

source:
  - path: app.c

filter:
  - name: Wireless Technology
    value: [Thread]
  - name: Device Type
    value: [SoC]
  - name: Project Difficulty
    value: [Advanced]
